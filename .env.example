# Filón — variables de entorno. Copiá este archivo como .env y completá lo que necesites.
# Sin ninguna variable, el juego funciona con el banco de reserva (datos/reserva.json).
# En Vercel (VERCEL=1) cambian algunos valores por defecto: COOKIE_SEGURA=1, CONFIAR_PROXY=1
# y PROGRAMADOR_INTERNO=0.

# ───────── Base de datos ─────────
# Turso (libSQL). Sin URL se usa el archivo RUTA_BD.
# BD_URL/BD_TOKEN tienen prioridad: usalas en Production con la base principal, porque la integración
# de Turso en Vercel puede crear una rama vacía por despliegue en TURSO_DATABASE_URL/TURSO_AUTH_TOKEN.
BD_URL=
BD_TOKEN=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
RUTA_BD=datos/filon.db

# ───────── Servidor ─────────
PUERTO=3000
HOST=0.0.0.0
# Zona del desafío diario (cambia a las 00:00 locales).
ZONA_HORARIA=America/Argentina/Buenos_Aires
# Poné 1 cuando el sitio se sirva por HTTPS (cookie Secure). En Vercel es siempre 1.
COOKIE_SEGURA=0
# Poné 1 si hay un proxy inverso delante (usa X-Forwarded-For para limitar solicitudes).
CONFIAR_PROXY=0
# Firma de la cookie anónima. Si queda vacía se genera una y se guarda en la base.
SECRETO_SESION=
# Habilita /api/admin/* con «Authorization: Bearer <token>». Vacío = deshabilitado.
TOKEN_ADMIN=
# Secreto que Vercel Cron envía a /api/cron/* («Authorization: Bearer …»). También sirve
# «Bearer TOKEN_ADMIN» mientras ADMIN_PERMITIR_BEARER=1; la cookie del panel no.
CRON_SECRET=

# ───────── Reglas ─────────
SEGUNDOS_POR_PREGUNTA=25
# Margen para respuestas enviadas justo al límite (latencia de red).
GRACIA_RED_MS=1500
# Horas, después del fin del día, para terminar una partida empezada antes de medianoche.
HORAS_PARA_RETOMAR=12
MAX_INTENTOS_POR_RONDA=40
# Días sin repetir preguntas ni conjuntos de respuestas.
DIAS_SIN_REPETIR=60
# Carga manual: días (más los ya programados) con los que se comparan las preguntas del JSON.
SIMILITUD_DIAS=3

# ───────── Generador por catálogos (sin IA; ver docs/GENERADOR.md) ─────────
# «catalogos» arma Normal con catálogos verificados y plantillas; «reserva» (por omisión), con el banco curado.
GENERADOR_NORMAL=reserva
CATALOGOS_SEMILLA=filon
# Una consigna puede repetirse cuando pasaron al menos estos días calendario (a 59 no, a 60 sí).
CATALOGOS_DIAS_SIN_REPETIR=60
CATALOGOS_MAX_RESPUESTAS=15000
# 1: si faltan candidatos se completa con la reserva (lote «mixto»); 0: no se publica y la corrida falla.
CATALOGOS_COMPLETAR_CON_RESERVA=1

# ───────── Reserva ─────────
# Dominios aceptados como fuente de las preguntas (separados por comas). Vacío = lista por defecto.
DOMINIOS_FUENTES=

# ───────── Tarea programada ─────────
# 1: el propio servidor publica (al iniciar, cada N minutos y después de medianoche).
# 0: usá cron o systemd con scripts/generar-desafio.js (ver despliegue/), o Vercel Cron (vercel.json).
PROGRAMADOR_INTERNO=1
MINUTOS_ENTRE_REVISIONES=10
# Minutos antes de medianoche a partir de los cuales se prepara el desafío de mañana.
MINUTOS_RESERVA_ANTES_DE_MEDIANOCHE=30

# ───────── Solo para pruebas manuales ─────────
# Desplaza el reloj del servidor (ms). Ej.: para probar la medianoche sin esperar.
RELOJ_DESFASE_MS=0

# ───────── Panel de administración ─────────
# Sesión del panel: minutos sin actividad y vida máxima en horas.
ADMIN_INACTIVIDAD_MIN=30
ADMIN_VIDA_HORAS=8
# Transición: 1 acepta «Authorization: Bearer TOKEN_ADMIN» (scripts/curl). Poné 0 para exigir sesión.
ADMIN_PERMITIR_BEARER=1

# ───────── Retención (días) ─────────
RETENER_VISITANTES_DIAS=90
RETENER_INTENTOS_DIAS=180
RETENER_REPORTES_DIAS=365
RETENER_CORRIDAS_DIAS=180

# ───────── Solo pruebas ─────────
# Multiplica los máximos de los límites de solicitudes (E2E). En producción, 1.
LIMITES_ESCALA=1
