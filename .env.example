# Filón — variables de entorno. Copiá este archivo como .env y completá lo que necesites.
# Sin ninguna variable, el juego funciona con el banco de reserva (datos/reserva.json).
# En Vercel (VERCEL=1) cambian algunos valores por defecto: COOKIE_SEGURA=1, CONFIAR_PROXY=1,
# PROGRAMADOR_INTERNO=0 e IA_PRESUPUESTO_MS=200000.

# ───────── Base de datos ─────────
# Turso (libSQL). Sin URL se usa el archivo RUTA_BD.
# BD_URL/BD_TOKEN tienen prioridad: usalas en Production con la base principal, porque la integración
# de Turso en Vercel puede crear una rama vacía por despliegue en TURSO_DATABASE_URL/TURSO_AUTH_TOKEN.
BD_URL=
BD_TOKEN=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
RUTA_BD=datos/filon.db

# ───────── Servidor ─────────
PUERTO=3000
HOST=0.0.0.0
# Zona del desafío diario (cambia a las 00:00 locales).
ZONA_HORARIA=America/Argentina/Buenos_Aires
# URL pública del juego (aparece en el identificador del verificador de fuentes).
URL_PUBLICA=
# Poné 1 cuando el sitio se sirva por HTTPS (cookie Secure).
COOKIE_SEGURA=0
# Poné 1 si hay un proxy inverso delante (usa X-Forwarded-For para limitar solicitudes).
CONFIAR_PROXY=0
# Firma de la cookie anónima. Si queda vacía se genera una y se guarda en la base.
SECRETO_SESION=
# Habilita /api/admin/* con «Authorization: Bearer <token>». Vacío = deshabilitado.
TOKEN_ADMIN=
# Secreto que Vercel Cron envía a /api/cron/* («Authorization: Bearer …»). TOKEN_ADMIN también sirve.
CRON_SECRET=

# ───────── Reglas ─────────
SEGUNDOS_POR_PREGUNTA=25
# Margen para respuestas enviadas justo al límite (latencia de red).
GRACIA_RED_MS=1500
# Horas, después del fin del día, para terminar una partida empezada antes de medianoche.
HORAS_PARA_RETOMAR=12
MAX_INTENTOS_POR_RONDA=40
# Días sin repetir preguntas ni conjuntos de respuestas.
DIAS_SIN_REPETIR=60
# Carga manual: días (más los ya programados) con los que se comparan las preguntas del JSON.
SIMILITUD_DIAS=3

# ───────── IA (generación diaria) ─────────
# Para activar la IA alcanza con UNA clave (Anthropic u OpenAI). Sin clave se usa solo la reserva.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai | simulado (desarrollo, sin red) | ninguno. Vacío: se detecta por la clave
# (con las dos, Anthropic). Si el elegido no tiene clave pero el otro sí, se usa el otro.
IA_PROVEEDOR=
# Vacíos = por defecto del proveedor: claude-opus-5-5 / claude-sonnet-5-5 o gpt-5 / gpt-5-mini.
# Un modelo del otro proveedor se ignora (p. ej. claude-* con OpenAI).
IA_MODELO=
# Revisor adversarial: conviene un modelo distinto del generador.
IA_MODELO_REVISOR=
IA_MAX_INTENTOS_POR_DIA=3
IA_CANDIDATAS_POR_CATEGORIA=2
IA_REVISION_ADVERSARIAL=1
IA_TIEMPO_LIMITE_MS=240000
# URLs de las APIs (solo para proxies o compatibles).
# ANTHROPIC_URL=https://api.anthropic.com/v1/messages
# OPENAI_URL=https://api.openai.com/v1/chat/completions
# Tope total para la IA en una corrida (0 = sin límite). Al agotarse se completa con la reserva.
IA_PRESUPUESTO_MS=0

# ───────── Verificación contra fuentes ─────────
# estricta: cada respuesta de la IA debe aparecer en las fuentes que delimitan el alcance.
# desactivada: solo para desarrollo sin internet.
VERIFICAR_FUENTES=estricta
# Dominios aceptados como fuente (separados por comas). Vacío = lista por defecto.
DOMINIOS_FUENTES=
# Contacto para el identificador del verificador (Wikipedia lo pide).
CONTACTO_FUENTES=
FUENTES_TIEMPO_LIMITE_MS=15000
WIKIDATA_TIEMPO_LIMITE_MS=45000

# ───────── Tarea programada ─────────
# 1: el propio servidor genera (al iniciar, cada N minutos y después de medianoche).
# 0: usá cron o systemd con scripts/generar-desafio.js (ver despliegue/), o Vercel Cron (vercel.json).
PROGRAMADOR_INTERNO=1
MINUTOS_ENTRE_REVISIONES=10
# Si la IA no logró preparar mañana, a partir de este margen se publica la reserva.
MINUTOS_RESERVA_ANTES_DE_MEDIANOCHE=30

# ───────── Solo para pruebas manuales ─────────
# Desplaza el reloj del servidor (ms). Ej.: para probar la medianoche sin esperar.
RELOJ_DESFASE_MS=0

# ───────── Panel de administración ─────────
# Sesión del panel: minutos sin actividad y vida máxima en horas.
ADMIN_INACTIVIDAD_MIN=30
ADMIN_VIDA_HORAS=8
# Transición: 1 acepta «Authorization: Bearer TOKEN_ADMIN» (scripts/curl). Poné 0 para exigir sesión.
ADMIN_PERMITIR_BEARER=1

# ───────── Topes de la IA ─────────
IA_MAX_LLAMADAS_POR_CORRIDA=30
IA_MAX_LLAMADAS_POR_DIA=90
# Precio por millón de tokens, solo para estimar el costo en los logs (0 = desconocido).
IA_COSTO_ENTRADA_USD_MTOK=0
IA_COSTO_SALIDA_USD_MTOK=0

# ───────── Fuentes externas ─────────
FUENTES_MAX_BYTES=3000000
FUENTES_MAX_REDIRECCIONES=3

# ───────── Retención (días) ─────────
RETENER_VISITANTES_DIAS=90
RETENER_INTENTOS_DIAS=180
RETENER_REPORTES_DIAS=365
RETENER_CORRIDAS_DIAS=180

# ───────── Solo pruebas ─────────
# Multiplica los máximos de los límites de solicitudes (E2E). En producción, 1.
LIMITES_ESCALA=1
