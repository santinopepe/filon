# /etc/systemd/system/filon-reserva.service — prepara mañana antes de medianoche
[Unit]
Description=Filón: preparar mañana con la reserva

[Service]
Type=oneshot
User=filon
WorkingDirectory=/opt/filon
EnvironmentFile=/opt/filon/.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning scripts/generar-desafio.js --manana
