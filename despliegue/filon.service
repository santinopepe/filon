# /etc/systemd/system/filon.service — servidor web de Filón
[Unit]
Description=Filón (juego diario)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=filon
WorkingDirectory=/opt/filon
EnvironmentFile=/opt/filon/.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning servidor/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
