# /etc/systemd/system/filon-generar.service — tarea diaria (solo si PROGRAMADOR_INTERNO=0)
# Asegura el desafío de hoy de cada modo con la reserva.
[Unit]
Description=Filón: generar desafío diario

[Service]
Type=oneshot
User=filon
WorkingDirectory=/opt/filon
EnvironmentFile=/opt/filon/.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning scripts/generar-desafio.js
SuccessExitStatus=2
